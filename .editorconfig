root = true

# C# code style and analysis rules come from the Workleap.DotNet.CodingStandards package (see Directory.Build.props).
# This file only covers what the package cannot: formatting of the other file types.

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

[*.{csproj,props,targets,slnx,xml,config,nuspec,resx}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
